{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "question": "deny",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "cmake *": "allow",
      "./build/core-test": "allow",
      "./build/core-test *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "sed -n *": "allow",
      "unzip -l *": "allow",
      "od *": "allow",
      "xxd *": "allow",
      "file *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push*": "deny",
      "git merge*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git rebase*": "deny",
      "git stash*": "deny",
      "ssh root@192.168.1.50 *": "allow",
