# Run as `cmake -DROOT=<repo> -DOUT=<file.cpp> -P cmake/EmbedCjk.cmake`: the three tables in src/cjk/ as C arrays
# (src/tagtext.cpp inflates them on first use).
set(code "// Generated by cmake/EmbedCjk.cmake from src/cjk/*.bin: do not edit.\n#include <cstddef>\nnamespace bp {\n")
foreach(n cp932 gbk big5)
	file(READ "${ROOT}/src/cjk/${n}.bin" hex HEX)
	string(LENGTH "${hex}" hexlen)
	math(EXPR len "${hexlen} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n" bytes "${bytes}")
	string(APPEND code "extern const unsigned char CJK_${n}[] = {\n${bytes}\n};\nextern const size_t CJK_${n}_LEN = ${len};\n")
endforeach()
string(APPEND code "}\n")
file(WRITE "${OUT}" "${code}")
