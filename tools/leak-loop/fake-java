#!/usr/bin/env python3
# a stand-in for the manga engine: answers 200 on the port the player names, until SIGTERM
import sys, re, http.server
port = 0
for a in sys.argv:
    m = re.match(r"-Dsuwayomi\.tachidesk\.config\.server\.port=(\d+)", a)
    if m: port = int(m.group(1))
class H(http.server.BaseHTTPRequestHandler):
    def _ok(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n: self.rfile.read(n)
        b = b'{"data":{}}'
        self.send_response(200); self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)
    do_GET = _ok
    do_POST = _ok
    def log_message(self, *a): pass
print("fake engine on", port, flush=True)
http.server.ThreadingHTTPServer(("127.0.0.1", port), H).serve_forever()
